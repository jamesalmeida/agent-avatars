{
  "name": "@jamesalmeida/agent-avatars",
  "version": "0.5.0",
  "description": "An animated face for your AI agent: a squishy shape with two eyes that blinks, listens, thinks, works, reads, writes, smiles, startles, puzzles, nods, winks, dozes off and spins. React, zero dependencies.",
  "keywords": [
    "react",
    "avatar",
    "ai",
    "agent",
    "chatbot",
    "animation",
    "assistant"
  ],
  "license": "MIT",
  "author": "James Almeida (https://www.jamesalmeida.me)",
  "homepage": "https://github.com/jamesalmeida/agent-avatars#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesalmeida/agent-avatars.git"
  },
  "bugs": "https://github.com/jamesalmeida/agent-avatars/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite demo",
    "build:demo": "vite build demo",
    "build:pages": "vite build demo --base=/agent-avatars/",
    "preview:svg": "node --experimental-strip-types scripts/preview-svg.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
